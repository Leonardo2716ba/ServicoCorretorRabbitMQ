# Copie para .env e ajuste os valores: cp .env.example .env

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE_GRADING_REQUESTS=grading.requests
RABBITMQ_QUEUE_GRADING_RESULTS=grading.results

# ---------- API Express ----------
EXPRESS_API_HOST=localhost
EXPRESS_API_PORT=3000

# ---------- Worker ----------
WORKER_MEM_LIMIT=64m

# ---------- Opcionais (valores padrao do worker) ----------
# SANDBOX_IMAGE=runner-sandbox
# SANDBOX_DEFAULT_MEM_LIMIT=32m
# SANDBOX_MAX_TIME_LIMIT_SECONDS=2
# SANDBOX_CPU_QUOTA=90000
# RABBITMQ_PREFETCH_COUNT=2